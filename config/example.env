# Hugging Face token (required for gated models like Qwen/Qwen-Image-Edit-2509).
# Get one at https://huggingface.co/settings/tokens and accept the model license first.
HF_TOKEN=

# Root directory where model weights are downloaded (used by download.py).
MODEL_ROOT=models

# --- Runtime / download config (shared by serve.py and download.py) ---
# Inference steps for the Lightning model: 4 (fast) or 8 (better quality).
QIE_NUM_STEPS=4
# Quantization rank: 32 (default) or 128 (better quality, larger).
QIE_RANK=32
# Precision: RTX 30/40-series use INT4. Only RTX 50-series (Blackwell) support FP4.
# Leave empty for auto-detect, or force "int4"/"fp4".
QIE_PRECISION=int4
# Device: leave empty for auto (cuda:1 if >=2 GPUs, else cuda:0).
# Override with "cuda:1" / "cuda:0" if needed.
QIE_DEVICE=
# Hugging Face repo for the quantized transformer (Nunchaku).
QIE_TRANSFORMER_REPO=nunchaku-tech/nunchaku-qwen-image-edit-2509
QIE_TRANSFORMER_SUBDIR=lightning-251115
# Base diffusers pipeline id (downloaded locally by download.py).
QIE_BASE_MODEL=Qwen/Qwen-Image-Edit-2509

# --- Server / UI config (serve.py) ---
QIE_OFFLOAD=auto
QIE_SERVER_NAME=0.0.0.0
QIE_PORT=7860
QIE_SHARE=false
