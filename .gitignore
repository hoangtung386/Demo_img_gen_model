# ============================================================
# Repo này là PUBLIC. Mọi thứ lọt vào đây là công khai vĩnh viễn —
# xoá commit sau đó KHÔNG gỡ được, phải rewrite history và coi như
# mọi credential đã lộ là đã bị đọc.
# ============================================================

# ============================================================
# Bí mật — KHÔNG BAO GIỜ commit
# ============================================================
# --- Biến môi trường ---
# `.env.*` phủ .env.local/.env.prod…; `*.env` phủ prod.env/staging.env ở mọi
# cấp; `.envrc` là của direnv, hay chứa `export AWS_…` nguyên văn.
.env
.env.*
*.env
.envrc

# `.model_paths.env` do download.py sinh: đường dẫn tuyệt đối của máy local,
# vô nghĩa với người khác và lộ cấu trúc thư mục máy bạn.
.model_paths.env

# --- Khoá riêng tư / chứng chỉ ---
*.pem
*.key
*.ppk
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.der
*.csr
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
.netrc
.npmrc
.pypirc
.htpasswd

# --- Service account / OAuth JSON ---
# Nhiều pattern chồng nhau là CỐ Ý: một key GCS lọt vào repo public nghĩa là
# phải thu hồi credential, không chỉ sửa git. Thà chặn thừa.
#
# Bài học cũ: pattern "ai-asset.json" KHÔNG khớp file thật "ai-asset-amb.json"
# và suýt để lọt key. Dùng wildcard ở mọi biến thể tên.
*-key.json
*_key.json
*credential*.json
*credentials*.json
*service-account*.json
*service_account*.json
client_secret*.json
ai-asset*.json
gcp-*.json
secrets/
config_setup/credentials/*.json
!config_setup/credentials/.gitkeep
!config_setup/credentials/README.md

# --- Config runtime chứa secret ---
# base.yaml có broker host/user/password/vhost + tên bucket. Chỉ commit
# base.example.yaml làm mẫu.
config_setup/base.yaml
# Compose tự nạp file này nếu có; nó là chỗ người ta hay nhét path/secret
# riêng của máy mình.
docker-compose.override.yml
docker-compose.*.local.yml

# --- Hạ tầng / cloud CLI ---
.aws/
.gcloud/
.azure/
.kube/
.terraform/
*.tfvars
*.tfstate
*.tfstate.*

# ============================================================
# Trọng số model (~10GB) và mọi thứ HuggingFace tải về
# ============================================================
# Dấu "/" đầu là BẮT BUỘC: "models/" không có nó sẽ khớp thư mục tên models ở
# MỌI cấp. (Lịch sử: từng nuốt luôn src/.../models/ và repo clone về thiếu
# code. Thư mục đó nay đã đổi tên thành hidream/, nhưng giữ "/" vẫn đúng.)
/models/

# Lưới an toàn: chặn file trọng số ở BẤT KỲ đâu, kể cả khi ai đó để nhầm
# ngoài models/. Một file .safetensors lọt vào lịch sử git là phải rewrite
# history mới gỡ ra được — và GitHub chặn file > 100MB nên push sẽ fail.
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.onnx
*.gguf
*.msgpack
*.h5

# Cache HuggingFace nếu ai đó trỏ HF_HOME ra ngoài models/
.hf/
.cache/

# Archive trọng số dựng bằng scripts/pack_models.sh (hàng chục GB).
models.zip
models.tar
models.tar.*
*.tar.zst

# ============================================================
# Dữ liệu chạy thật — RỦI RO RIÊNG TƯ
# ============================================================
# Ảnh người dùng gửi lên + ảnh model sinh ra + payload RabbitMQ đầy đủ
# (firebase_token, device_id, appid). Đây là PII, tuyệt đối không lên repo
# public. Chặn CẢ thư mục `data/` chứ không chỉ 3 thư mục con đã biết: thêm
# một backend lưu trữ mới là lại có chỗ rò.
data/
data_predict/

# ============================================================
# Ảnh mẫu demo — mặc định KHÔNG commit (repo public)
# ============================================================
# Các case thử đồ / ghép người / hoán đổi khuôn mặt dùng ẢNH NGƯỜI THẬT.
# "Có quyền dùng cho demo nội bộ" KHÁC "phát hành công khai trên GitHub", nên
# mặc định ở đây là chặn. Thiếu ảnh thì demo vẫn chạy: ui/components.py trả
# None và khối ví dụ chỉ trống.
#
# Muốn commit một bộ ảnh ĐÃ RÕ GIẤY PHÉP (ảnh tự chụp, CC0, stock đã mua cho
# mục đích phát hành) thì thêm tay:
#     git add -f examples/<tên-ảnh>.jpg
# rồi ghi nguồn + giấy phép vào bảng trong examples/README.md.
examples/**/*.jpg
examples/**/*.jpeg
examples/**/*.png
examples/**/*.webp
examples/**/*.gif
examples/**/*.bmp
examples/**/*.heic
examples/**/*.avif
!examples/README.md
!examples/outputs/.gitkeep

# ============================================================
# Môi trường Python (.venv ở đây nặng ~15GB)
# ============================================================
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
pip-wheel-metadata/

