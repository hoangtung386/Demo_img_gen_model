# ============================================================
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pytype/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
*.prof
*.lprof

# Jupyter — .ipynb_checkpoints giữ bản nháp CŨ của notebook, gồm cả output
# đã in ra (token, đường dẫn, dữ liệu mẫu) mà bạn tưởng đã xoá.
.ipynb_checkpoints/

# ============================================================
# Gradio / runtime
# ============================================================
# Thư mục tạm + file flag Gradio sinh lúc chạy. `flagged/` chứa ảnh người
# dùng bấm nút flag — cùng loại rủi ro với data/.
.gradio/
flagged/
gradio_cached_examples/

# Log chạy nền (README hướng dẫn nohup ... > serve.log). Log của service này
# có in prompt và đường dẫn ảnh.
*.log
logs/
nohup.out
*.pid

# Ảnh sinh ra lúc chạy. Dấu "/" đầu bắt buộc, nếu không "outputs/" sẽ khớp cả
# examples/outputs/.
/outputs/
/output/
/results/
/tmp/
/temp/

# ============================================================
# IDE / hệ điều hành / tàn dư merge
# ============================================================
.vscode/
.idea/
.fleet/
.zed/
.history/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
