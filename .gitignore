# ============================================================
# Bí mật — KHÔNG BAO GIỜ commit
# ============================================================
.env
.env.*
!config/example.env
.model_paths.env
*.pem
*.key
service-account*.json
gcp-credentials*.json

# ============================================================
# Trọng số model (~27GB) và mọi thứ HuggingFace tải về
# ============================================================
# Dấu "/" đầu là BẮT BUỘC: "models/" không có nó sẽ khớp thư mục tên models ở
# MỌI cấp, nuốt luôn src/gen_image/models/ (loader.py, offload.py) và
# repo clone về sẽ thiếu code.
/models/

# Lưới an toàn: chặn file trọng số ở BẤT KỲ đâu, kể cả khi ai đó
# để nhầm ngoài models/. Một file .safetensors lọt vào lịch sử git
# là phải rewrite history mới gỡ ra được.
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.onnx
*.gguf
*.msgpack
*.h5

# Cache HuggingFace nếu ai đó trỏ HF_HOME ra ngoài models/
.hf/
.cache/

# ============================================================
# Môi trường Python (.venv ở đây nặng ~15GB)
# ============================================================
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
pip-wheel-metadata/

# ============================================================
# Cache công cụ
# ============================================================
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ============================================================
# Gradio / runtime
# ============================================================
# Thư mục tạm + file flag Gradio sinh lúc chạy.
.gradio/
flagged/
gradio_cached_examples/

# Log chạy nền (README hướng dẫn nohup ... > serve.log).
*.log
nohup.out

# Ảnh sinh ra lúc chạy. Hai lưu ý:
#  - KHÔNG dùng pattern *.png / *.jpg toàn cục: examples/ là asset của demo và
#    phải được commit — xem ghi chú cuối file.
#  - Dấu "/" đầu cũng bắt buộc ở đây, nếu không "outputs/" sẽ khớp cả
#    examples/outputs/ và xoá mất ảnh kết quả dựng sẵn.
/outputs/
/output/
/results/
/tmp/
/temp/

# ============================================================
# IDE / hệ điều hành
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================================
# Công cụ trợ lý
# ============================================================
.claude-dev-helper/
.claude/settings.local.json

# ============================================================
# GIỮ LẠI có chủ đích
# ============================================================
# examples/          (3.5MB) ảnh mẫu + kết quả dựng sẵn. Đây là ASSET chức
#                    năng, không phải data: UI đọc để hiện ví dụ bấm-là-chạy,
#                    thiếu thì tính năng demo cache mất tác dụng (app vẫn
#                    chạy). Image KHÔNG bake thư mục này nữa — compose mount
#                    ./examples:ro lúc chạy. Giấy phép từng ảnh ghi trong
#                    examples/README.md.
# uv.lock            (450KB) khoá phiên bản — bắt buộc commit để build lặp lại được.
# config/example.env template biến môi trường, không chứa bí mật.
#
# Muốn loại kết quả dựng sẵn khỏi repo thì thêm: examples/outputs/
# --- Secret GCS + archive trọng số ---------------------------------------
#
# "ai-asset.json" KHÔNG khớp file thật "ai-asset-amb.json" — pattern cũ để
# lọt key service account vào git. Dùng wildcard để mọi biến thể tên đều dính.
# `*-key.json` phủ luôn model-download-key.json / user-upload-key.json.
ai-asset*.json
*-key.json
*service-account*.json

# Archive trọng số dựng bằng scripts/pack_models.sh (hàng chục GB).
models.zip
models.tar
models.tar.*

# --- Queue worker service (gen_image.queue_service) ---
# base.yaml chứa secret (broker host/user/password/vhost, bucket) — KHÔNG
# commit. Chỉ commit base.example.yaml làm mẫu.
config_setup/base.yaml
# Service-account JSON cho storage backend — không bao giờ commit.
config_setup/credentials/*.json
# Audit 7-day store + staging tạm của mỗi request.
data_predict/
data/staging/
# Ảnh placeholder do smoke test sinh ra (storage backend local). Container
# chạy bằng root nên thư mục này thuộc root trên host — xoá bằng sudo rm -rf.
data/smoke_out/
